# Copy this file to .env (already gitignored) and fill in your Razorpay
# TEST MODE credentials from Dashboard -> Settings -> API Keys.
# Never commit the real .env file or paste these values into chat.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_test_secret_here

# Demo shopping agent (agent/*.py). LLM_PROVIDER picks which key below is
# used ("gemini" default, or "groq") -- both are free, no card required.
# RECOMMENDED: gemini. Verified live (2026-09-06) as the one that actually
# works end-to-end for this vision-driven agent -- see shopping_agent.py's
# module docstring for the two dead ends ruled out first (Groq's vision
# models cap free-tier requests at 7,000 input tokens/minute, well under
# what one browser-use step needs regardless of vision on/off; Gemini's
# newest flash model caps brand-new projects at 20 requests/DAY). Groq is
# kept as a working non-vision fallback (USE_VISION=false path) in case
# Gemini's quota is ever the blocker instead.
LLM_PROVIDER=gemini

# Gemini 3.1 Flash-Lite -- free tier: 30 RPM / 1,500 req/day / 1M TPM:
# https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Groq (Qwen3.6-27B, vision, but free-tier TPM is too small for this
# agent -- see note above) -- free tier: 30 RPM / 14,400 req/day, no card:
# https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
